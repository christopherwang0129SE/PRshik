# Copy to backend/.env and fill in. Never commit the real .env.

# --- Nebius Token Factory (OpenAI-compatible chat completions) ---
# Leave NEBIUS_API_KEY empty to keep the pure-git conflict score.
# Model: NVIDIA Nemotron 3 Super. https://nebius.com/services/token-factory/nemotron
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Set to false to skip the model even when a key is present.
NEBIUS_ENABLED=true
# Seconds for the single chat-completions attempt (no retries).
NEBIUS_TIMEOUT_SECONDS=40
# Top-K: how many prefiltered branch pairs may call the model per request.
NEBIUS_MAX_PAIRS=5
# Listed Nemotron 3 Super price (USD per 1M tokens) for the cost estimate.
NEMOTRON_INPUT_USD_PER_1M=0.30
NEMOTRON_OUTPUT_USD_PER_1M=0.90

# --- Verify-by-test (generated pytest on high-risk pairs; local repos only) ---
VERIFY_ENABLED=true
VERIFY_MIN_SCORE=70
# os.pathsep-separated roots where generated tests may run (the demo/ folder is always allowed).
VERIFY_ALLOWED_ROOTS=
VERIFY_TIMEOUT_SECONDS=30
VERIFY_MAX_ATTEMPTS=3
VERIFY_MAX_PAIRS=3
# A confirmed verdict sets level=high and floors the shown score at this value.
VERIFY_CONFIRMED_FLOOR=90

# --- Tavily (library documentation for the risk and verify prompts) ---
# Leave empty to skip doc lookup. Never commit a real key.
TAVILY_API_KEY=
# Set to false to skip Tavily even when a key is present.
TAVILY_ENABLED=true
# Seconds for one search request.
TAVILY_TIMEOUT_SECONDS=8
# Results requested per search. Snippets are trimmed to a small budget.
TAVILY_MAX_RESULTS=3

# --- Hosted demo (see docs/DEPLOY.md) ---
# Comma-separated browser origins. Default is the local Vite dev server.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional. Matched against the whole Origin value. Empty disables it.
# Vercel preview example: https://mergeguard-demo.*\.vercel\.app
CORS_ALLOW_ORIGIN_REGEX=
# true: POST /api/analyze accepts only demo/checkout-demo and demo/api-demo.
# repo_url and any other path return 403. Leave false for local development.
DEMO_MODE=false

# --- GitHub pull-request integration ---
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GITHUB_SEATED_USERS=

# --- App ---
DEFAULT_BASE_BRANCH=main
WORKSPACE_DIR=.workspace
